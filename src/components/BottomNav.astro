---
const { page } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;

const navItems = [
  {
    id: "inicio",
    href: baseUrl,
    text: "Inicio",
  },
  {
    id: "carta",
    href: `${baseUrl}carta/`,
    text: "Carta",
  },
  {
    id: "contacto",
    href: `${baseUrl}contacto/`,
    text: "Contacto",
  },
];
---

<nav class="navegacion-inferior" aria-label="Menú principal">
  {
    navItems.map((item) => (
      <a class:list={[{ activo: item.id === page }]} href={item.href}>
        <b>
          {
            item.id === "inicio" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 10.5 12 3l9 7.5" />
                <path d="M5 9.5V21h14V9.5" />
                <path d="M9 21v-6h6v6" />
              </svg>
            )
          }
          {
            item.id === "carta" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 4h14v16H5z" />
                <path d="M8 8h8" />
                <path d="M8 12h8" />
                <path d="M8 16h5" />
              </svg>
            )
          }
          {
            item.id === "contacto" && (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 21s6-5.2 6-11a6 6 0 0 0-12 0c0 5.8 6 11 6 11z" />
                <path d="M12 12.2a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4z" />
              </svg>
            )
          }
        </b>
        {item.text}
      </a>
    ))
  }
</nav>
