---
const { subtitle } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<header class="barra-superior">
  <a href={baseUrl} class="marca" aria-label="Ir al inicio">
    <div class="marca-logo">
      <img src={`${baseUrl}assets/favicon.png`} alt="" />
    </div>
    <div>
      <strong>Cervecería Tramsburgo</strong>
      <small>{subtitle}</small>
    </div>
  </a>
  <a class="enlace-telefono" href="tel:+34 976 965 079">Llamar</a>
</header>
