---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/carta.css";

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Carta" page="carta" subtitle="Carta del bar">
  <section class="cabecera-pagina">
    <div class="etiqueta-seccion">Carta</div>
    <h1>Carta completa.</h1>
    <p>Consulta el menú por secciones y abre cada página para verla en grande.</p>
  </section>

  <section aria-labelledby="carta-imagenes-titulo">
    <div class="cabecera-seccion">
      <div>
        <h2 id="carta-imagenes-titulo">Menú</h2>
        <p>Páginas actualizadas</p>
      </div>
    </div>

    <div class="navegacion-carta" aria-label="Secciones de la carta">
      <a href="#desayunos">Desayunos</a>
      <a href="#tapas">Tapas</a>
      <a href="#bebidas">Bebidas</a>
      <a href="#alergenos">Alérgenos</a>
    </div>

    <div class="imagenes-carta">
      <article id="desayunos" class="pagina-carta">
        <div class="cabecera-carta">
          <div>
            <span>Página 1</span>
            <h3>Desayunos y platos rápidos</h3>
          </div>
          <a href={`${baseUrl}assets/carta-01.webp`} target="_blank" rel="noopener">Ver grande</a>
        </div>
        <a class="enlace-carta" href={`${baseUrl}assets/carta-01.webp`} target="_blank" rel="noopener">
          <img
            src={`${baseUrl}assets/carta-01.webp`}
            alt="Carta de desayunos, sandwiches, wraps, tortillas, hamburguesas y hot dogs"
            loading="lazy"
            decoding="async"
          />
        </a>
      </article>

      <article id="tapas" class="pagina-carta">
        <div class="cabecera-carta">
          <div>
            <span>Página 2</span>
            <h3>Raciones, tapas, ensaladas y bocadillos</h3>
          </div>
          <a href={`${baseUrl}assets/carta-02-raciones-bocadillos.webp`} target="_blank" rel="noopener">Ver grande</a>
        </div>
        <a class="enlace-carta" href={`${baseUrl}assets/carta-02-raciones-bocadillos.webp`} target="_blank" rel="noopener">
          <img
            src={`${baseUrl}assets/carta-02-raciones-bocadillos.webp`}
            alt="Carta de raciones, tapas, ensaladas, bocadillos calientes y bocadillos fríos"
            loading="lazy"
            decoding="async"
          />
        </a>
      </article>

      <article id="bebidas" class="pagina-carta">
        <div class="cabecera-carta">
          <div>
            <span>Página 3</span>
            <h3>Cafés, refrescos, zumos y vinos</h3>
          </div>
          <a href={`${baseUrl}assets/carta-03-bebidas.webp`} target="_blank" rel="noopener">Ver grande</a>
        </div>
        <a class="enlace-carta" href={`${baseUrl}assets/carta-03-bebidas.webp`} target="_blank" rel="noopener">
          <img
            src={`${baseUrl}assets/carta-03-bebidas.webp`}
            alt="Carta de cafés, refrescos, batidos, zumos y vinos"
            loading="lazy"
            decoding="async"
          />
        </a>
      </article>

      <article id="alergenos" class="pagina-carta">
        <div class="cabecera-carta">
          <div>
            <span>Página 4</span>
            <h3>Nachos, suplementos y alérgenos</h3>
          </div>
          <a href={`${baseUrl}assets/carta-04-suplementos-alergenos.webp`} target="_blank" rel="noopener">Ver grande</a>
        </div>
        <a class="enlace-carta" href={`${baseUrl}assets/carta-04-suplementos-alergenos.webp`} target="_blank" rel="noopener">
          <img
            src={`${baseUrl}assets/carta-04-suplementos-alergenos.webp`}
            alt="Carta de nachos, suplementos y listado de alérgenos"
            loading="lazy"
            decoding="async"
          />
        </a>
      </article>
    </div>
  </section>
</BaseLayout>
